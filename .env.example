# Copy this file to `.env` and set your API base URL.
#
# Local (development): your PC's LAN IP while a tunnel is off
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
#
# Anywhere (tunnel): a Cloudflare/ngrok HTTPS URL so phones on other
# networks can reach the FastAPI detection server
# EXPO_PUBLIC_API_BASE_URL=https://your-tunnel.trycloudflare.com