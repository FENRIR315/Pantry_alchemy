{
  "expo": {
    "name": "Pantry Alchemy",
    "slug": "pantry-alchemy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantryalchemy",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pantryalchemy.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.pantryalchemy.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FAF1DC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Pantry Alchemy uses the camera to scan your groceries and pantry items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pantry Alchemy accesses your photo library so you can upload photos to scan."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF1DC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
